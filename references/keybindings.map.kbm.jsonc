    "when": "config.keyboardNavigation.enabled && terminalFocus && panelFocus && config.workbench.sideBar.location == 'right' && panelPosition == 'top' && config.keyboardNavigation.letter.keys == 'kbm'"
  },
  {
    // [keynav] (map) (right) (juke) (move) (1) (red) (A) (panel) (terminal)
    "key": "shift+alt+}",
    "command": "shift+alt+} a1fb",
    "when": "config.keyboardNavigation.enabled && terminalFocus && panelFocus && config.workbench.sideBar.location == 'right' && panelPosition == 'top' && config.keyboardNavigation.letter.keys == 'kbm'"
  }
]
